DATABASE_URL=postgresql+asyncpg://evalharness:evalharness@localhost:5432/evalharness
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_COMPATIBLE_BASE_URL=https://example.invalid
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL_REVISION=immutable-revision
JUDGE_PROVIDER_RPM=60
JUDGE_PROVIDER_TPM=60000
NLI_PROVIDER_RPM=60
NLI_PROVIDER_TPM=60000
HARNESS_VERSION=0.1.0
GIT_SHA=local
LOG_LEVEL=INFO
LOG_FORMAT=auto
# Payload content is omitted by default. Enable only for scrubbed development data.
LOG_PAYLOADS=false
# Plain hashes can reveal low-entropy outputs; opt in only when correlation is needed.
LOG_PAYLOAD_HASHES=false
LOG_PAYLOAD_MAX_CHARS=240
LOG_PROGRESS_EVERY=100
OTEL_ENABLED=false
# When set with OTEL_ENABLED=true, spans are exported over OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
