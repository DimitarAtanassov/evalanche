{#
  One dashboard, read top to bottom: verdict, quality, reliability, cost, provenance.
  Sections whose data is absent are omitted rather than rendered empty.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>evalanche run report {{ report.run_id }}</title>
<style>
  :root {
    --ink:#111820; --muted:#5b6675; --line:#e4e8ee; --bg:#ffffff; --soft:#f7f9fb;
    --accent:#2f5bd7; --good:#17784f; --bad:#b42318;
  }
  * { box-sizing:border-box; }
  body {
    margin:0; background:var(--bg); color:var(--ink);
    font:15px/1.55 system-ui,-apple-system,'Segoe UI',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap { max-width:1080px; margin:0 auto; padding:48px 28px 96px; }
  header { border-bottom:1px solid var(--line); padding-bottom:24px; }
  .eyebrow { font-size:11px; letter-spacing:.09em; text-transform:uppercase; color:var(--muted); font-weight:600; }
  h1 { font-size:27px; letter-spacing:-.02em; margin:8px 0 6px; font-weight:650; }
  .run-meta { color:var(--muted); font-size:13.5px; }
  code { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.9em; }

  .verdict { display:flex; align-items:center; gap:20px; flex-wrap:wrap;
    border:1px solid var(--line); border-radius:10px; padding:16px 20px; margin-top:24px; background:var(--soft); }
  .badge { font-size:13px; font-weight:650; padding:5px 12px; border-radius:999px; }
  .badge.ok { background:#e7f4ed; color:var(--good); }
  .badge.fail { background:#fdecea; color:var(--bad); }
  .gates { list-style:none; display:flex; gap:26px; flex-wrap:wrap; margin:0; padding:0; font-size:13px; }
  .gates li { display:flex; align-items:baseline; gap:7px; }
  .gate-mark { font-weight:700; }
  .gates li.ok .gate-mark { color:var(--good); }
  .gates li.fail .gate-mark { color:var(--bad); }
  .gate-value { color:var(--muted); }

  .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line);
    border:1px solid var(--line); border-radius:10px; overflow:hidden; margin-top:28px; }
  .kpi { background:var(--bg); padding:18px 20px; }
  .kpi-label { font-size:12px; color:var(--muted); font-weight:550; }
  .kpi-value { font-size:30px; letter-spacing:-.025em; font-weight:620; margin:6px 0 4px; font-variant-numeric:tabular-nums; }
  .kpi-sub { font-size:12px; color:var(--muted); font-variant-numeric:tabular-nums; }

  section { margin-top:56px; }
  h2 { font-size:19px; font-weight:620; letter-spacing:-.015em; margin:6px 0 4px; }
  .lede { color:var(--muted); font-size:13.5px; margin:0 0 22px; max-width:62ch; }
  .figure { border:1px solid var(--line); border-radius:10px; padding:18px 18px 12px; margin-bottom:18px; }
  .figure h3 { font-size:14px; font-weight:600; margin:0 0 2px; }
  .caption { font-size:11.5px; color:var(--muted); margin:0 0 12px; }
  .chart { width:100%; }
  .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; }
  .ctx { border:1px solid var(--line); border-radius:10px; padding:16px 18px; background:var(--soft); }
  .ctx h3 { font-size:13px; font-weight:650; margin:0 0 10px; letter-spacing:.02em; text-transform:uppercase; color:var(--muted); }
  .ctx dl { margin:0; display:grid; grid-template-columns:auto 1fr; gap:6px 12px; font-size:13px; }
  .ctx dt { color:var(--muted); }
  .ctx dd { margin:0; word-break:break-word; }
  .prompt-body, .io-text {
    margin:8px 0 0; padding:10px 12px; background:var(--bg); border:1px solid var(--line);
    border-radius:8px; font:12.5px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;
    white-space:pre-wrap; word-break:break-word; color:var(--ink);
  }
  .examples { display:flex; flex-direction:column; gap:14px; }
  .example { border:1px solid var(--line); border-radius:10px; padding:14px 16px; }
  .example-head { display:flex; flex-wrap:wrap; gap:10px 16px; align-items:baseline;
    font-size:12.5px; color:var(--muted); margin-bottom:10px; }
  .example-head strong { color:var(--ink); font-weight:600; }
  .pass-pill { font-size:11.5px; font-weight:650; padding:2px 8px; border-radius:999px; }
  .pass-pill.ok { background:#e7f4ed; color:var(--good); }
  .pass-pill.fail { background:#fdecea; color:var(--bad); }
  .pass-pill.na { background:var(--soft); color:var(--muted); }
  .io-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; }
  .io-label { font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); font-weight:600; }

  table { border-collapse:collapse; width:100%; font-size:13px; font-variant-numeric:tabular-nums; }
  caption { text-align:left; font-size:11.5px; color:var(--muted); padding-bottom:8px; }
  th { text-align:left; font-weight:600; font-size:11.5px; letter-spacing:.04em; text-transform:uppercase;
    color:var(--muted); border-bottom:1px solid var(--line); padding:8px 10px 8px 0; }
  td { padding:8px 10px 8px 0; border-bottom:1px solid var(--line); }
  tr:last-child td { border-bottom:0; }
  details { border:1px solid var(--line); border-radius:10px; padding:0 18px; }
  details[open] { padding-bottom:14px; }
  summary { cursor:pointer; font-size:13px; font-weight:550; padding:13px 0; color:var(--muted); }

  footer { margin-top:56px; padding-top:20px; border-top:1px solid var(--line);
    font-size:12px; color:var(--muted); line-height:1.8; }
  footer code { word-break:break-all; }
  @media (max-width:820px) {
    .kpis { grid-template-columns:repeat(2,1fr); }
    .grid-2, .grid-3, .io-grid { grid-template-columns:1fr; }
  }
</style>
<script>{{ runtime|safe }}</script>
</head>
<body>
<div class="wrap">

<header>
  <div class="eyebrow">Evaluation run report</div>
  <h1>{{ report.model_digest }}</h1>
  <div class="run-meta">
    Run <code>{{ report.run_id }}</code> · status {{ report.run_status }} ·
    {{ "{:,}".format(report.written_generations) }} generations · schema <code>{{ report.schema_version }}</code>
  </div>
</header>

<div class="verdict">
  <span class="badge {{ 'ok' if report.publishable else 'fail' }}">
    {{ "Publishable" if report.publishable else "Not publishable" }}</span>
  <ul class="gates">
  {% for gate in gates %}
    <li class="{{ 'ok' if gate.ok else 'fail' }}">
      <span class="gate-mark">{{ "\u2713" if gate.ok else "\u2717" }}</span>
      <span class="gate-name">{{ gate.name }}</span>
      <span class="gate-value">{{ gate.value }}</span>
    </li>
  {% endfor %}
  </ul>
</div>

<div class="kpis">
  <div class="kpi">
    <div class="kpi-label">
      {%- if report.headline_kind == "mean" -%}
      Mean — {{ report.primary_metric }}
      {%- else -%}
      Pass rate — {{ report.primary_metric }}
      {%- endif -%}
    </div>
    <div class="kpi-value">
      {%- if report.pass_rate is none %}—{% else %}{{ "%.1f%%"|format(report.pass_rate * 100) }}{% endif -%}
    </div>
    <div class="kpi-sub">
      {%- if report.pass_rate_ci.low is not none and report.pass_rate_ci.high is not none -%}
      {{ report.confidence_method }} CI
      {{ "%.1f"|format(report.pass_rate_ci.low * 100) }}–{{ "%.1f%%"|format(report.pass_rate_ci.high * 100) }}
      · n={{ "{:,}".format(report.pass_rate_n) }}
      {%- else -%}
      {{ report.confidence_method }} · n={{ "{:,}".format(report.pass_rate_n) }}
      {%- endif -%}
    </div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Coverage</div>
    <div class="kpi-value">{{ "%.2f%%"|format(report.coverage * 100) }}</div>
    <div class="kpi-sub">{{ "{:,}".format(report.written_generations - report.harness_failures) }} of
      {{ "{:,}".format(report.planned_generations) }} planned · floor
      {{ "%.0f%%"|format(report.coverage_floor * 100) }}</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Cost per correct answer</div>
    <div class="kpi-value">
      {%- if report.cost_per_correct is none %}—{% else %}${{ "%.4f"|format(report.cost_per_correct) }}{% endif -%}
    </div>
    <div class="kpi-sub">${{ "%.2f"|format(report.cost_usd_total) }} total ·
      {{ "{:,}".format(report.written_generations) }} generations</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Latency p95</div>
    <div class="kpi-value">{{ "{:,.0f}".format(report.latency.p95) }} ms</div>
    <div class="kpi-sub">p50 {{ "{:,.0f}".format(report.latency.p50) }} ms ·
      max {{ "{:,.0f}".format(report.latency['max']) }} ms</div>
  </div>
</div>

<section>
  <div class="eyebrow">Context</div>
  <h2>What was evaluated, and on what?</h2>
  <p class="lede">Model, dataset, prompt, and decode settings for this run, plus a bounded sample
     of inputs and outputs so the charts below have concrete grounding. Text is truncated;
     full raw provider payloads stay in the database.</p>

  <div class="grid-3">
    <div class="ctx">
      <h3>Model</h3>
      <dl>
        <dt>Provider</dt><dd>{{ report.model.provider or "—" }}</dd>
        <dt>Model</dt><dd><code>{{ report.model.model or "—" }}</code></dd>
        <dt>Resolved</dt><dd><code>{{ report.model.resolved_version or report.model_digest or "—" }}</code></dd>
        {% if report.model.quantization %}<dt>Quantization</dt><dd>{{ report.model.quantization }}</dd>{% endif %}
        {% if report.model.params_b is not none %}<dt>Params</dt><dd>{{ report.model.params_b }}B</dd>{% endif %}
        {% if report.model.context_window is not none %}<dt>Context</dt><dd>{{ "{:,}".format(report.model.context_window) }} tokens</dd>{% endif %}
      </dl>
    </div>
    <div class="ctx">
      <h3>Dataset</h3>
      <dl>
        <dt>Name</dt><dd><code>{{ report.dataset.name or "—" }}</code></dd>
        <dt>Version</dt><dd>{{ report.dataset.version or "—" }}</dd>
        <dt>Split</dt><dd>{{ report.dataset.split or "—" }}</dd>
        <dt>Cases</dt><dd>{{ "{:,}".format(report.dataset.case_count) }}</dd>
        {% if report.dataset.slice_dimensions %}
        <dt>Slices</dt><dd>{{ report.dataset.slice_dimensions | join(", ") }}</dd>
        {% endif %}
        {% if report.dataset.license %}<dt>License</dt><dd>{{ report.dataset.license }}</dd>{% endif %}
        {% if report.dataset.pii_scrubbed is not none %}
        <dt>PII scrubbed</dt><dd>{{ "yes" if report.dataset.pii_scrubbed else "no" }}</dd>
        {% endif %}
      </dl>
    </div>
    <div class="ctx">
      <h3>Decode</h3>
      <dl>
        {% if report.decode_params %}
          {% for key, value in report.decode_params.items() %}
          <dt><code>{{ key }}</code></dt><dd>{{ value }}</dd>
          {% endfor %}
        {% else %}
          <dt>—</dt><dd>No decode params recorded</dd>
        {% endif %}
      </dl>
    </div>
  </div>

  {% if report.prompt_template.body or report.prompt_template.name %}
  <div class="figure" style="margin-top:18px">
    <h3>Prompt template
      {%- if report.prompt_template.name %}
      — <code>{{ report.prompt_template.name }}</code>
      {% if report.prompt_template.version %}v{{ report.prompt_template.version }}{% endif %}
      {%- endif %}</h3>
    <p class="caption">Truncated body used for generation · sha
      <code>{{ report.prompt_template.content_sha256 or "—" }}</code></p>
    {% if report.prompt_template.body %}
    <pre class="prompt-body">{{ report.prompt_template.body }}</pre>
    {% endif %}
  </div>
  {% endif %}

  {% if report.case_examples %}
  <div style="margin-top:22px">
    <h3 style="font-size:14px;font-weight:600;margin:0 0 4px">Sampled cases</h3>
    <p class="caption">Up to {{ report.case_examples|length }} examples · failures and harness issues first ·
      scored on <code>{{ report.primary_metric }}</code></p>
    <div class="examples">
    {% for ex in report.case_examples %}
      <div class="example">
        <div class="example-head">
          <strong><code>{{ ex.case_id }}</code></strong>
          <span>{{ ex.task_type }}{% if ex.repeat_idx %} · repeat {{ ex.repeat_idx }}{% endif %}</span>
          {% if ex.slices %}
          <span>{% for k, v in ex.slices.items() %}<code>{{ k }}={{ v }}</code>{% if not loop.last %} · {% endif %}{% endfor %}</span>
          {% endif %}
          <span class="pass-pill {{ 'ok' if ex.passed is sameas true else ('fail' if ex.passed is sameas false else 'na') }}">
            {%- if ex.passed is sameas true %}passed
            {%- elif ex.passed is sameas false %}failed
            {%- else %}{{ ex.outcome }}{% endif -%}
            {%- if ex.metric_value is not none %} · {{ "%.3f"|format(ex.metric_value) }}{% endif -%}
          </span>
          {% if ex.latency_ms is not none %}<span>{{ "{:,.0f}".format(ex.latency_ms) }} ms</span>{% endif %}
        </div>
        <div class="io-grid">
          <div>
            <div class="io-label">Input</div>
            <pre class="io-text">{{ ex.input or "—" }}</pre>
          </div>
          <div>
            <div class="io-label">Reference</div>
            <pre class="io-text">{{ ex.reference or "—" }}</pre>
          </div>
          <div>
            <div class="io-label">Output</div>
            <pre class="io-text">{{ ex.output or "—" }}</pre>
          </div>
        </div>
      </div>
    {% endfor %}
    </div>
  </div>
  {% endif %}
</section>

{% if charts.metric or charts.slice or overall_aggregates %}
<section>
  <div class="eyebrow">Quality</div>
  <h2>How good is the model on this dataset?</h2>
  <p class="lede">Every score is an interval, not a point. Bars show the metric value; whiskers
     show the 95% confidence interval.</p>

  {% if charts.metric %}
  <div class="figure">
    <h3>Metric scores with 95% confidence intervals</h3>
    <p class="caption">Source: this run · overall slice · interval method shown per metric in the table below</p>
    {{ charts.metric|safe }}
  </div>
  {% endif %}

  {% if charts.slice %}
  <div class="figure">
    <h3>{{ report.primary_metric }} pass rate by slice</h3>
    <p class="caption">Source: this run · sorted worst to best · dotted line is the overall rate ·
      whiskers are {{ report.confidence_method }} intervals
      {%- if slice_aggregates|length > 1 and slice_aggregates[0].value < slice_aggregates[-1].value %}
      · weakest slice: <strong>{{ slice_aggregates[0].slice }}</strong> at
      {{ "%.1f%%"|format(slice_aggregates[0].value * 100) }}
      {%- else %} · all slices scored equally{% endif %}</p>
    {{ charts.slice|safe }}
  </div>
  {% endif %}

  <details>
    <summary>Metric and slice tables</summary>
    <table>
      <caption>Metric aggregates — overall slice</caption>
      <tr><th>Metric</th><th>Version</th><th>n</th><th>Value</th><th>95% CI</th><th>Method</th></tr>
      {% for row in overall_aggregates %}
      <tr>
        <td><code>{{ row.metric }}</code></td>
        <td>{{ row.version }}</td>
        <td>{{ "{:,}".format(row.n) }}</td>
        <td>{{ "%.4f"|format(row.value) }}</td>
        <td>{% if row.ci_low is none %}—{% else %}{{ "%.4f"|format(row.ci_low) }}–{{ "%.4f"|format(row.ci_high) }}{% endif %}</td>
        <td>{{ row.method }}</td>
      </tr>
      {% endfor %}
    </table>
    {% if slice_aggregates %}
    <table style="margin-top:22px">
      <caption>{{ report.primary_metric }} by slice — worst first</caption>
      <tr><th>Slice</th><th>n</th><th>Value</th><th>95% CI</th><th>Method</th></tr>
      {% for row in slice_aggregates %}
      <tr>
        <td><code>{{ row.slice }}</code></td>
        <td>{{ "{:,}".format(row.n) }}</td>
        <td>{{ "%.4f"|format(row.value) }}</td>
        <td>{% if row.ci_low is none %}—{% else %}{{ "%.4f"|format(row.ci_low) }}–{{ "%.4f"|format(row.ci_high) }}{% endif %}</td>
        <td>{{ row.method }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
  </details>
</section>
{% endif %}

<section>
  <div class="eyebrow">Reliability</div>
  <h2>What broke, and whose fault was it?</h2>
  <p class="lede">Harness failures are never counted as model failures. They are excluded from the
     quality denominator and reported separately as coverage loss.</p>

  {% if charts.outcome %}
  <div class="figure">
    <h3>Generation outcomes by category</h3>
    <p class="caption">Source: this run · {{ "{:,}".format(report.written_generations) }} generations ·
      {{ report.harness_failures }} harness failure(s) excluded from the quality denominator</p>
    {{ charts.outcome|safe }}
  </div>
  {% endif %}

  <details>
    <summary>Finish reasons, retries, and cache</summary>
    <table>
      <caption>Provider finish reasons and execution counters</caption>
      <tr><th>Finish reason</th><th>Generations</th></tr>
      {% for key, value in report.finish_reasons.items() %}
      <tr><td><code>{{ key }}</code></td><td>{{ "{:,}".format(value) }}</td></tr>
      {% endfor %}
      <tr><td><strong>Retries</strong></td><td>{{ "{:,}".format(report.retries) }}</td></tr>
      <tr><td><strong>Cache hits</strong></td><td>{{ "{:,}".format(report.cache_hits) }}
        ({{ "%.1f%%"|format(report.cache_rate * 100) }})</td></tr>
    </table>
  </details>
</section>

<section>
  <div class="eyebrow">Cost and speed</div>
  <h2>What did this run cost to produce?</h2>
  <p class="lede">Latency is reported as percentiles, never as a mean alone.</p>
  <div class="grid-2">
    {% if charts.latency %}
    <div class="figure">
      <h3>End-to-end latency percentiles</h3>
      <p class="caption">Source: this run · milliseconds ·
        {{ "{:,}".format(report.written_generations) }} generations</p>
      {{ charts.latency|safe }}
    </div>
    {% endif %}
    <div class="figure">
      <h3>Latency table</h3>
      <p class="caption">Accessible equivalent of the chart, including the mean</p>
      <table>
        <tr><th>Statistic</th><th>Value</th></tr>
        {% for key, value in report.latency.items() %}
        <tr><td>{{ key }}</td><td>{{ "{:,.2f}".format(value) }} ms</td></tr>
        {% endfor %}
      </table>
    </div>
  </div>
</section>

<footer>
  <strong style="color:var(--ink)">Provenance.</strong> Reproduce with the digests below.<br>
  config <code>{{ report.config_sha256 }}</code><br>
  dataset <code>{{ report.dataset_sha256 }}</code><br>
  model <code>{{ report.model_digest }}</code>
  {%- if report.trace_ids_sample %}<br>
  trace sample: {% for trace in report.trace_ids_sample %}<code>{{ trace }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
  {%- endif %}<br>
  Flaky cases excluded from claims: {{ report.flaky_cases_excluded }}.
  Sampled inputs/outputs and a truncated prompt body are included for context;
  full raw provider responses remain in the database only.
</footer>

</div>
</body>
</html>
